{
  "name": "dsh-ssh-remote",
  "version": "0.6.0",
  "description": "SSH remote workspaces and a graphical directory picker for DeepSeek Harness Desktop.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./ui/client.js"
  },
  "files": [
    "index.js",
    "lib",
    "ui",
    "scripts/profile.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/remote-workspace.png",
    "docs/directory-picker.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenqaq123/dsh-remote-ssh.git"
  },
  "homepage": "https://github.com/chenqaq123/dsh-remote-ssh#readme",
  "bugs": {
    "url": "https://github.com/chenqaq123/dsh-remote-ssh/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "ssh",
    "remote-workspace"
  ],
  "bin": {
    "dsh-ssh-remote": "scripts/profile.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
